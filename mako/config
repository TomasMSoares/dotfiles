# Core
max-visible=5
sort=-time
layer=top
anchor=top-right

# Style & Layout
font=JetBrainsMono Nerd Font 12
width=320
height=110
margin=10
padding=12
border-size=2
border-radius=8
icons=1
max-icon-size=48

# Colors (Example Dark Palette)
background-color=#1e1e2e
text-color=#edd8f2
border-color=#f09eff
progress-color=over #313244

# Expiration
default-timeout=5000
ignore-timeout=0

# Urgency Overrides
[urgency=critical]
border-color=#f38ba8
default-timeout=0

# Claude Code agent waiting for you (scripts/tmux-agent-state)
[app-name="Claude Code"]
border-color=#ff8700
default-timeout=15000

[app-name="Claude Code" body~="^Done"]
border-color=#87af87
default-timeout=8000
