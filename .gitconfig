[core]
  editor = nvim

[pull]
  rebase = true

[init]
  defaultBranch = main

[alias]
  pf = push --force-with-lease

# Use the Porsche SSH key for any repo whose remote is in the porsche-code org,
# regardless of cwd (e.g. pre-commit clones hook repos into ~/.cache/pre-commit)
[includeIf "hasconfig:remote.*.url:git@github.com:porsche-code/**"]
  path = ~/.gitconfig-porsche-ssh

# Identity-based configuration switching
# Default: personal. The includeIf rules below come later, so they override it per folder
[include]
  path = ~/.gitconfig-personal

# Work
[includeIf "gitdir:~/source/InternalTools/"]
  path = ~/.gitconfig-reply
[includeIf "gitdir:~/source/IFCO/"]
  path = ~/.gitconfig-reply
[includeIf "gitdir:~/source/VW/"]
  path = ~/.gitconfig-reply
[includeIf "gitdir:~/source/Porsche/"]
  path = ~/.gitconfig-porsche

# TUM GitLab
[includeIf "gitdir:~/TUM/Master/1FS/ParProg/"]
  path = ~/.gitconfig-tum
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
