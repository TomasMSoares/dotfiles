[core]
  editor = nvim

[pull]
  rebase = true

[init]
  defaultBranch = main

[alias]
  pf = push --force-with-lease

# Identity-based configuration switching
# Personal
[includeIf "gitdir:~/personal/"]
  path = ~/.gitconfig-personal
[includeIf "gitdir:~/dotfiles/"]
  path = ~/.gitconfig-personal
[includeIf "gitdir:~/TUM/Master/1FS/DevOps/"]
  path = ~/.gitconfig-personal

# Work
[includeIf "gitdir:~/source/InternalTools/"]
  path = ~/.gitconfig-reply
[includeIf "gitdir:~/source/IFCO/"]
  path = ~/.gitconfig-reply
[includeIf "gitdir:~/source/DXONE/"]
  path = ~/.gitconfig-reply
[includeIf "gitdir:~/source/Porsche/"]
  path = ~/.gitconfig-porsche

# TUM GitLab
[includeIf "gitdir:~/TUM/Master/1FS/ParProg/"]
  path = ~/.gitconfig-tum
