#!/usr/bin/env bash

# Claude Code hook: tmux-agent-state <working|blocked|done|clear>
# Marks the agent's tmux window with @claude_state (drawn as a dot in the tmux status bar)
# and sends a notification when the agent is blocked or done while you're not looking at it.
# Hook JSON arrives on stdin; this script must print nothing to stdout.

state=$1
input=$(cat)

# Not running inside tmux: nothing to mark
[[ -n "$TMUX_PANE" ]] || exit 0

# @claude_pane lets tmux.conf tell the agent's pane apart from others in its window
set_state() { tmux set -w -t "$TMUX_PANE" @claude_state "$1" \; set -w -t "$TMUX_PANE" @claude_pane "$TMUX_PANE"; }
clear_state() { tmux set -wu -t "$TMUX_PANE" @claude_state \; set -wu -t "$TMUX_PANE" @claude_pane; }

# Is this window on screen right now? (current window of an attached session, Ghostty focused)
visible() {
	[[ $(tmux display -p -t "$TMUX_PANE" '#{&&:#{window_active},#{session_attached}}') == 1 ]] || return 1
	if [[ "$OSTYPE" == "darwin"* ]]; then
		[[ $(lsappinfo info -only bundleID "$(lsappinfo front)") == *com.mitchellh.ghostty* ]] || return 1
		# Ghostty is in front, but is its focused terminal the tmux client showing this window?
		local front here
		front=$(osascript -e 'tell application "Ghostty" to get tty of focused terminal of selected tab of front window' 2>/dev/null) || return 1
		here=$(tmux display -p -t "$TMUX_PANE" '#{session_name} #{window_id}')
		tmux list-clients -F '#{client_tty} #{session_name} #{window_id}' | grep -qxF "$front $here"
		return
	fi
	command -v hyprctl >/dev/null || return 0
	# The focused window must be the Ghostty window showing this tmux window, recognised by the title tmux gives it
	[[ $(hyprctl activewindow -j 2>/dev/null | jq -r '"\(.class)\t\(.title)"') == *ghostty*$'\t'"$(tmux_title)" ]]
}

# Terminal title tmux sets (set-titles) for this pane's window
tmux_title() { tmux display -p -t "$TMUX_PANE" "$(tmux show -gv set-titles-string)"; }

notify() {
	local where
	where=$(tmux display -p -t "$TMUX_PANE" '#S › #I #W')
	if [[ "$OSTYPE" == "darwin"* ]]; then
		# Clicking the notification runs this script again to focus the right Ghostty window and tmux pane.
		# It runs outside tmux with a bare environment, so pass along everything it needs
		terminal-notifier -title "Claude Code" -subtitle "$where" -message "$1" -group "claude-$TMUX_PANE" \
			-execute "$(printf 'PATH=%q TMUX=%q TMUX_PANE=%q %q focus </dev/null' "$PATH" "$TMUX" "$TMUX_PANE" "$0")" >/dev/null
	else
		# --wait blocks until the notification closes and prints the action if it was clicked,
		# so wait in the background to let the hook return right away
		(
			[[ $(notify-send -a "Claude Code" --action=default=Focus --wait "$where" "$1") == default ]] &&
				"$0" focus
		) </dev/null >/dev/null 2>&1 &
		disown
	fi
}

# tty of the tmux client best suited to show this pane: one already on its window,
# else one on its session, else the most recently used. In Ghostty this is also the terminal's tty
client_tty() {
	local here
	here=$(tmux display -p -t "$TMUX_PANE" '#{session_name}	#{window_id}')
	tmux list-clients -F '#{client_activity}	#{client_tty}	#{session_name}	#{window_id}' |
		sort -rn | awk -F'\t' -v here="$here" '
			$3 "\t" $4 == here { print $2; found = 1; exit }
			$3 == substr(here, 1, index(here, "\t") - 1) && !session { session = $2 }
			!any { any = $2 }
			END { if (!found) print (session ? session : any) }'
}

# First line of the agent's final message, read from the session transcript
last_message() {
	local transcript
	transcript=$(jq -r '.transcript_path // empty' <<<"$input")
	[[ -f "$transcript" ]] || return
	tail -n 100 "$transcript" |
		jq -rs '[.[] | select(.type == "assistant") | .message.content[]? | select(.type == "text") | .text] | last // empty' |
		sed -n '/[^[:space:]]/{s/^[#*> -]*//;p;q}' | head -c 140
}

case "$state" in
working)
	# A tool cut short by Ctrl-C/Esc also lands here (PostToolUseFailure): the turn is over, keep it cancelled.
	# Interrupts outside a tool fire no hook at all; tmux.conf catches those keys instead
	if [[ $(jq -r '.is_interrupt // false' <<<"$input") == true ]]; then
		set_state cancelled
	else
		set_state working
	fi
	;;
blocked)
	previous=$(tmux show -wv -t "$TMUX_PANE" @claude_state 2>/dev/null)
	set_state blocked
	# One notification per block, and none if you're already looking at it
	[[ "$previous" == blocked ]] && exit 0
	visible && exit 0

	tool=$(jq -r '.tool_name // empty' <<<"$input")
	case "$tool" in
	AskUserQuestion) body="Has a question for you" ;;
	Bash) body="Wants to run: $(jq -r '.tool_input.command' <<<"$input" | head -c 120)" ;;
	"") body="Needs your input" ;;
	*) body="Wants to use $tool" ;;
	esac
	notify "$body"
	;;
done)
	# Idle recaps (away summaries) also fire Stop, but no prompt or tool use came first:
	# only a real turn leaves the window working or blocked.
	# Stop never fires after an interrupt, so cancelled here means Ctrl-C/Esc didn't actually stop the turn
	case $(tmux show -wv -t "$TMUX_PANE" @claude_state 2>/dev/null) in
	working | blocked | cancelled) ;;
	*) exit 0 ;;
	esac
	# Finished while you were watching: no green dot or notification needed
	if visible; then
		clear_state
	else
		set_state "done"
		body=$(last_message)
		notify "Done: ${body:-finished its turn}"
	fi
	;;
clear)
	clear_state
	;;
focus)
	# Notification clicked: switch the best client to this pane, then raise its Ghostty window
	tty=$(client_tty)
	# Hyprland only knows windows by title, so note the client's title before switching changes it
	old_title=$(tmux list-clients -F "#{client_tty}	$(tmux show -gv set-titles-string)" | awk -F'\t' -v t="$tty" '$1 == t { print $2 }')
	[[ -n "$tty" ]] && tmux switch-client -c "$tty" -t "$TMUX_PANE"
	if [[ "$OSTYPE" == "darwin"* ]]; then
		osascript -e 'on run {t}' -e 'tell application "Ghostty"' -e 'activate' \
			-e 'if t is not "" then focus (first terminal whose tty is t)' -e 'end tell' -e 'end run' "$tty" >/dev/null
	elif command -v hyprctl >/dev/null; then
		address=$(hyprctl clients -j | jq -r --arg old "$old_title" --arg new "$(tmux_title)" \
			'map(select(.class | test("ghostty"))) | map(select(.title == $old or .title == $new)) | first | .address // empty')
		[[ -n "$address" ]] && hyprctl dispatch focuswindow "address:$address" >/dev/null
	fi
	;;
esac

exit 0
