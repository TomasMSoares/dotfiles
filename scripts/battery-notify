#!/usr/bin/env bash

# Battery notification daemon script
BATTERY_PATH="/sys/class/power_supply/BAT0"
NOTIFIED_LOW=false
NOTIFIED_CRITICAL=false

# Exit if battery doesn't exist
if [[ ! -d "$BATTERY_PATH" ]]; then
    exit 0
fi

while true; do
    capacity=$(cat "$BATTERY_PATH/capacity" 2>/dev/null || echo 100)
    status=$(cat "$BATTERY_PATH/status" 2>/dev/null || echo "Discharging")

    if [[ "$status" == "Discharging" ]]; then
        if [[ "$capacity" -le 10 && "$NOTIFIED_CRITICAL" == "false" ]]; then
            notify-send -u critical "Battery Very Low" "Battery is at ${capacity}%. Please connect charger!" -i battery-caution
            NOTIFIED_CRITICAL=true
            NOTIFIED_LOW=true
        elif [[ "$capacity" -le 20 && "$NOTIFIED_LOW" == "false" ]]; then
            notify-send -u normal "Battery Low" "Battery is at ${capacity}%." -i battery-low
            NOTIFIED_LOW=true
        fi
    else
        # Reset flags when charging or full
        NOTIFIED_LOW=false
        NOTIFIED_CRITICAL=false
    fi

    sleep 30
done
