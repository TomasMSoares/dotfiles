font-family = "JetBrainsMono Nerd Font"
font-size = 14

background-opacity = 0.6
background-blur = true

window-padding-x = 10
window-padding-y = 10
cursor-style = block
cursor-style-blink = true

# --- UNCOMMENT DESIRED BACKGROUND / SHADER ---
# custom-shader = shaders/drunkard.glsl
# custom-shader = shaders/dither.glsl
# custom-shader = shaders/matrix-hallway.glsl
# custom-shader = shaders/bettercrt.glsl
# custom-shader = shaders/mnoise.glsl
# custom-shader = shaders/smoke-and-ghost.glsl

custom-shader-animation = always

background = #292320

macos-titlebar-style = hidden

# Every window is a tmux client (scripts/tmux-open), so closing one just detaches: nothing to confirm.
# Login shell so the script finds tmux (Homebrew PATH) when Ghostty is started from the Dock
command = zsh -lc "$HOME/dotfiles/scripts/tmux-open"
confirm-close-surface = false
# Cmd+Enter opens another tmux window, like SUPER+Return on Hyprland (fullscreen stays on Cmd+Ctrl+F)
keybind = super+enter=new_window

# Left Option sends Alt (tmux Alt-1..9), right Option still types special characters
macos-option-as-alt = left
